hlOn   = input.bool(true, "High / low prices", group = gD, inline = "w", display = display.none)
tickOn = input.bool(true, "25 / 37.5 / 50% ticks", group = gD, inline = "w", tooltip = "Each candle's 25, 37.5 and 50% back from its last extreme, as the Session Map draws them.", display = display.none)
c25    = input.color(color.blue, "25%", group = gD, inline = "tk", display = display.none)
