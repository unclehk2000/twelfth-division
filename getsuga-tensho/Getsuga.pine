gD = "Day candles · Mon–Fri right of price (Session Map style)"
dcOn   = input.bool(true, "Show", group = gD, inline = "d0", tooltip = "Built from this chart's bars, one per trading day (18:00 → 17:00). Use a 15-minute chart: on 1–3 minutes the start of the week may not be loaded.", display = display.none)
dcWk   = input.bool(true, "Week candle", group = gD, inline = "d0", display = display.none)
dcOff  = input.int(15, "Offset from chart (bars)", minval = 1, maxval = 400, group = gD, tooltip = "The Session Map's candles also start 15 bars right of price. With both on, set this to about 80 so they sit side by side.", display = display.none)
