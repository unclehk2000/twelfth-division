//@version=6
// Getsuga · two weekly dealing ranges, each a fib from Friday (1) to Monday (0), split in eighths with SDs at 1.5 and −0.5 and
// run through the week. Each can be turned on or off.
// Tenshō: 1 = Friday's Shikai mid, 0 = Monday's. A day's Shikai mid is the midpoint of its overnight range (18:00 → 09:29 ET),
// as in the Shikai / Bankai Session Map. Set at Monday 09:30.
// Jūjishō: 1 = the CE of Friday's first presented FVG, 0 = the CE of Monday's. The first presented FVG is Byakugan's: on
// 1-minute bars, the first three-candle wick gap from 09:30, finished by 09:59. Read from 1-minute data on any chart of 1 to
// 15 minutes. Set when Monday's gap prints (median 09:35).
// Last week's high / low and the week open are reference lines only. Day candles right of price in the Session Map's style.
// Two cards read one of the ranges: the week as a ladder (every level in price order, price slotted in, ✓ or the odds by
// Friday 17:00) and NY · 15M for today. For Jūjishō the week card adds its state: coiled or not, which way Monday shifted,
// and the two gaps.
// Odds: NQ + ES + RTY 1-minute 2018–26, 1,187 weeks (roll weeks left out), fitted on Tenshō's levels. They depend only on the
// distance and the time left; on NQ 2018–26 (402 Jūjishō weeks) they fit the Jūjishō levels within 4 points.
indicator("Getsuga · Tenshō & Jūjishō Weekly Dealing Ranges", "Getsuga", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 100)

TZ = "America/New_York"

// ═══════════════════════════════════════════════════════════════ Inputs
gV = "View"
themeI   = input.string("Auto", "Card theme", options = ["Auto", "Dark", "Light"], group = gV, tooltip = "The card. Auto follows the chart background.", display = display.none)
lblSzI   = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal"], group = gV, display = display.none)
txtColI  = input.color(#000001, "Chart text colour", group = gV, tooltip = "Labels that are not tied to a line's colour. Left at the default it follows the chart background.", display = display.none)
showCard = input.bool(true, "Week card", group = gV, inline = "cd", display = display.none)
cardPos  = input.string("Top right", "", options = ["Top left", "Top center", "Top right", "Middle left", "Middle right", "Bottom left", "Bottom center", "Bottom right"], group = gV, inline = "cd", tooltip = "The week as a ladder: the anchors, EQ, the SDs and PWH / PWL in price order, with price slotted in between them, each with ✓ or its odds by Friday.", display = display.none)
showNY   = input.bool(true, "NY · 15M card", group = gV, inline = "ny", display = display.none)
nyPos    = input.string("Bottom right", "", options = ["Top left", "Top center", "Top right", "Middle left", "Middle right", "Bottom left", "Bottom center", "Bottom right"], group = gV, inline = "ny", tooltip = "Today, for a 15-minute trader: the nearest eighth and the nearest key level on each side of price, how far in ATR15, and the odds of trading by 11:00 and by 16:59, or ✓ once traded today. Which key level is likely first, the 09:30 open and ATR15.", display = display.none)
layI     = input.string("Desktop", "Layout", options = ["Desktop", "Mobile"], group = gV, tooltip = "Desktop: every row. Mobile: two narrow cards for a phone (the key levels either side of price, and today's odds). Every row keeps its explanation in the tooltip.", display = display.none)
mkOn     = input.bool(true, "Markers where levels trade", group = gV, tooltip = "A fixed marker on the bar where each key level (1, 0.5, 0, 1.5 SD, −0.5 SD) of the range the cards read, and PWH / PWL, first trades this week. Drawn once, never moved.", display = display.none)
keepW    = input.int(1, "Weeks on the chart", minval = 1, maxval = 4, group = gV, tooltip = "How many weekly ranges stay drawn, this week's included.", display = display.none)

gM = "Modes · turn each range on or off"
tenOn   = input.bool(true, "Getsuga Tenshō · Friday's Shikai mid → Monday's", group = gM, tooltip = "1 = Friday's Shikai mid (the midpoint of its overnight, 18:00 → 09:29 ET), 0 = Monday's, set at Monday 09:30.", display = display.none)
formOn  = input.bool(true, "Draw Tenshō while Monday's mid forms", group = gM, active = tenOn, tooltip = "Sunday 18:00 → Monday 09:30 Monday's overnight is still forming, so 0 moves with it. The card shows FORMING and no odds until 09:30.", display = display.none)
jjOn    = input.bool(true, "Getsuga Jūjishō · Friday's first presented FVG → Monday's", group = gM, tooltip = "1 = the CE (midpoint) of Friday's first presented FVG, 0 = Monday's, set when Monday's prints.\nFirst presented FVG, as Byakugan draws it: on 1-minute bars, the first three candles from 09:30 whose wicks leave a gap (low of the third above the high of the first, or the mirror), with the third candle starting by 09:59. On NQ 2018–26 a day had one 99.8% of the time; the median prints at 09:35.\nIt is read from 1-minute data on any chart of 1 to 15 minutes, so a 15-minute chart shows the same gaps as Byakugan on 1 minute.", display = display.none)
jBoxOn  = input.bool(true, "Show the two gaps", group = gM, inline = "jb", active = jjOn, display = display.none)
jGapC   = input.color(color.new(#e53935, 70), "", group = gM, inline = "jb", tooltip = "Friday's and Monday's first presented FVGs, drawn for an hour from where they formed.", display = display.none)
cardsBy = input.string("Jūjishō", "Cards and markers read", options = ["Jūjishō", "Tenshō"], group = gM, active = tenOn and jjOn, tooltip = "With both ranges on, which one the two cards and the ✓ markers follow.", display = display.none)

gR = "Lines and labels"
x1Md   = input.string("Friday's anchor", "Lines start at", options = ["Friday's anchor", "When the range is set"], group = gR, tooltip = "Friday's anchor: where Friday's line starts (Tenshō: the earlier of Friday's overnight high and low; Jūjishō: Friday's gap), as a fib drawn from Friday to Monday would.\nWhen the range is set: Monday 09:30 (Tenshō) or when Monday's gap prints (Jūjishō).", display = display.none)
x2Md   = input.string("Past the day candles", "Lines run to", options = ["Past the day candles", "Friday 17:00"], group = gR, inline = "x2", display = display.none)
offN   = input.int(6, "+ bars", minval = 0, maxval = 300, group = gR, inline = "x2", tooltip = "This week's lines only; past weeks end at their Friday 17:00.\nPast the day candles: the lines end + bars after the day candles (after the last bar when the candles are off), so the labels sit just right of price.\nFriday 17:00: they end where the week does, which on a low timeframe can put the labels off screen.", display = display.none)
lblFmt = input.string("Fraction (price)", "Labels", options = ["Fraction (price)", "Fraction", "Off"], group = gR, tooltip = "At the right end of each line, e.g. 0.875 (30,023.25), the way TradingView's fib tool labels them.", display = display.none)
nameOn = input.bool(true, "Name the anchors and SDs", group = gR, tooltip = "Adds · Fri mid / · Mon mid (Tenshō), · Fri FVG / · Mon FVG (Jūjishō) and · SD to those labels.", display = display.none)

