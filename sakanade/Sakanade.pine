//@version=6
// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © Unclehk2000
// Sakanade · is the high or low already in? Live odds that the day's high and low (18:00–17:00 ET) and the week's high and low
// hold to the close of the day and of the week. The day odds come from gradient-boosted trees (50 trees, depth 3) built on a
// Brownian touch probability that knows the intraday volatility profile, plus the time of day, the range used, the extreme
// against PDH / PDL, where and when the extreme was set and whether a CPI / NFP / FOMC release is still ahead today. Trained on
// NQ + ES + RTY 1-minute 2018–24 (911,630 samples), scored once on 2025 – Oct 2026 (237,142): Brier 0.135 against 0.239 for a
// flat rate and 0.138 for the Brownian model alone (log-loss gain 0.007, 95% CI 0.003–0.011, better on all three markets).
// The week odds use the Brownian model alone: the trees did not beat it out of sample (gain −0.003, CI −0.011 to 0.006).
// The odds are drawn on price at each extreme and as lines in the pane, with a card.
// ICT teaches the time of day and the weekly profiles where highs and lows form; the tests found the extremes pile up at the
// edges of each window (NY PM and Asia for the day, Friday and Monday for the week), as the arcsine law says they should.
// Not affiliated with or endorsed by ICT.
indicator("Sakanade · Is the High or Low In?", "Sakanade", overlay = false, max_lines_count = 50, max_labels_count = 50, precision = 0)

TZ = "America/New_York"

// ═══════════════════════════════════════════════════════════════ Inputs
gV = "View"
themeI  = input.string("Auto", "Card theme", options = ["Auto", "Dark", "Light"], group = gV, display = display.none)
lblSzI  = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal"], group = gV, display = display.none)
showCrd = input.bool(true, "Card", group = gV, inline = "cd", display = display.none)
crdPos  = input.string("Top right", "", options = ["Top left", "Top center", "Top right", "Middle left", "Middle right", "Bottom left", "Bottom center", "Bottom right"], group = gV, inline = "cd", display = display.none)
layI    = input.string("Desktop", "Layout", options = ["Desktop", "Mobile"], group = gV, tooltip = "Desktop: the four extremes and the tested rows. Mobile: the four extremes only.", display = display.none)

gL = "On price"
dayOn = input.bool(true, "Day high / low with odds", group = gL, inline = "d", display = display.none)
wkOn  = input.bool(true, "Week high / low with odds", group = gL, inline = "d", display = display.none)
extN  = input.int(10, "Extend right (bars)", minval = 0, maxval = 100, group = gL, display = display.none)
cHi   = input.color(#ef5350, "Highs", group = gL, inline = "c", display = display.none)
cLo   = input.color(#26a69a, "Lows", group = gL, inline = "c", display = display.none)

gP = "Pane"
pDay = input.bool(true, "Day odds", group = gP, inline = "p", tooltip = "The chance the day's high (red) and low (green) hold to 16:59, bar by bar.", display = display.none)
pWk  = input.bool(true, "Week odds", group = gP, inline = "p", tooltip = "The chance the week's high and low hold to Friday 16:59, dotted.", display = display.none)

gA = "Alerts · create one with \"Any alert() function call\""
alT = input.int(80, "Day odds cross above (%)", minval = 50, maxval = 99, group = gA, tooltip = "An alert when the chance the day's high, or low, holds first rises through this level.", display = display.none)
alOn = input.bool(false, "Alert", group = gA, display = display.none)

// ═══════════════════════════════════════════════════════════════ Helpers
bgLum  = 0.299 * color.r(chart.bg_color) + 0.587 * color.g(chart.bg_color) + 0.114 * color.b(chart.bg_color)
isDark = themeI == "Dark" or (themeI == "Auto" and bgLum < 128)
cTxt   = isDark ? #d1d4dc : #131722
cBody  = isDark ? #161a23 : #f4f6f9
cSub   = isDark ? #8a93a6 : #5d6476
cHdr   = #6d4c41
tSz = lblSzI == "Tiny" ? size.tiny : lblSzI == "Normal" ? size.normal : size.small
px(float v) => str.tostring(v, format.mintick)
pc0(float p) => na(p) ? "—" : str.tostring(math.round(100 * p)) + "%"
clamp(float v, float a, float b) => math.max(a, math.min(b, v))
gauge(float f, int n) =>
    int k = na(f) ? 0 : int(math.round(clamp(f, 0, 1) * n))
    str.repeat("█", k) + str.repeat("░", n - k)
posOf(string p) =>
    switch p
        "Top left"      => position.top_left
        "Top center"    => position.top_center
        "Top right"     => position.top_right
        "Middle left"   => position.middle_left
        "Middle right"  => position.middle_right
        "Bottom left"   => position.bottom_left
        "Bottom center" => position.bottom_center
        => position.bottom_right
nCdf(float x) =>
    float z = math.abs(x)
    float t = 1.0 / (1.0 + 0.2316419 * z)
    float p = 1.0 - 0.3989422804 * math.exp(-0.5 * z * z) * t * (0.319381530 + t * (-0.356563782 + t * (1.781477937 + t * (-1.821255978 + t * 1.330274429))))
    x >= 0 ? p : 1.0 - p
lgt(float p) =>
    float q = clamp(p, 0.000001, 0.999999)
    math.log(q / (1.0 - q))
lgs(float z) => 1.0 / (1.0 + math.exp(-z))
hm(int r) =>
    int t = (r + 1080) % 1440
    str.format("{0}:{1}", str.tostring(int(t / 60), "00"), str.tostring(t % 60, "00"))

// ═══════════════════════════════════════════════════════════════ Model constants
// expected variance still to come in the trading day, in daily ATR² units, from each 5-minute mark after 18:00 (NQ + ES + RTY 2018–24:
// the mean squared 1-minute range over the daily ATR(14), summed to 16:59); linear between marks
var array<float> CUM5 = array.from(1.12053, 1.10936, 1.10661, 1.10468, 1.10282, 1.10108, 1.09972, 1.09813, 1.09682, 1.09563, 1.09442, 1.09335, 1.09220, 1.09046, 1.08909, 1.08790, 1.08671, 1.08565, 1.08467, 1.08339, 1.08221, 1.08117, 1.07992, 1.07885, 1.07770, 1.07485, 1.07298, 1.07141, 1.06948, 1.06804, 1.06661, 1.06474, 1.06321, 1.06189, 1.06015, 1.05872, 1.05741, 1.05553, 1.05403, 1.05276, 1.05079, 1.04942, 1.04808, 1.04619, 1.04456, 1.04307, 1.04163, 1.04026, 1.03892, 1.03748, 1.03630, 1.03519, 1.03406, 1.03305, 1.03203, 1.03090, 1.02987, 1.02894, 1.02803, 1.02721, 1.02641, 1.02549, 1.02473, 1.02393, 1.02311, 1.02230, 1.02154, 1.02069, 1.02001, 1.01936, 1.01869, 1.01805, 1.01746, 1.01652, 1.01577, 1.01501, 1.01434, 1.01372, 1.01311, 1.01229, 1.01168, 1.01103, 1.01031, 1.00968, 1.00894, 1.00768, 1.00668, 1.00579, 1.00494, 1.00419, 1.00341, 1.00244, 1.00157, 1.00069, 0.99982, 0.99888, 0.99788, 0.99523, 0.99351, 0.99211, 0.99049, 0.98913, 0.98783, 0.98629, 0.98497, 0.98368, 0.98226, 0.98100, 0.97955, 0.97486, 0.97140, 0.96833, 0.96517, 0.96236, 0.95978, 0.95678, 0.95440, 0.95224, 0.94999, 0.94784, 0.94586, 0.94272, 0.94005, 0.93779, 0.93556, 0.93353, 0.93164, 0.92946, 0.92755, 0.92567, 0.92387, 0.92216, 0.92060, 0.91846, 0.91663, 0.91486, 0.91316, 0.91150, 0.90989, 0.90814, 0.90652, 0.90499, 0.90328, 0.90158, 0.89998, 0.89795, 0.89627, 0.89465, 0.89299, 0.89142, 0.88982, 0.88814, 0.88656, 0.88506, 0.88313, 0.88132, 0.87943, 0.87690, 0.87497, 0.87317, 0.87146, 0.86961, 0.86770, 0.86549, 0.86358, 0.86161, 0.85950, 0.85766, 0.85568, 0.85254, 0.85013, 0.84782, 0.84494, 0.84238, 0.83902, 0.81094, 0.80495, 0.80017, 0.79603, 0.79221, 0.78869, 0.78448, 0.78098, 0.77788, 0.77483, 0.77191, 0.76658, 0.73159, 0.70801, 0.68830, 0.66849, 0.65100, 0.63658, 0.61439, 0.59884, 0.58431, 0.57060, 0.55783, 0.54562, 0.53259, 0.52070, 0.50958, 0.49864, 0.48816, 0.47869, 0.46729, 0.45781, 0.44885, 0.44002, 0.43197, 0.42411, 0.41520, 0.40729, 0.39977, 0.39259, 0.38568, 0.37901, 0.37157, 0.36510, 0.35910, 0.35290, 0.34692, 0.34131, 0.33514, 0.32967, 0.32424, 0.31874, 0.31322, 0.30792, 0.30062, 0.29456, 0.28908, 0.28342, 0.27792, 0.27241, 0.26607, 0.26050, 0.25511, 0.24967, 0.24445, 0.23921, 0.22671, 0.21912, 0.21214, 0.20559, 0.19924, 0.19297, 0.18485, 0.17690, 0.16923, 0.16171, 0.15415, 0.14718, 0.13810, 0.13041, 0.12208, 0.11428, 0.10682, 0.09985, 0.09113, 0.08336, 0.07558, 0.06619, 0.05256, 0.03826, 0.02665, 0.02178, 0.01707, 0.01489, 0.01158, 0.01026, 0.00656, 0.00513, 0.00405, 0.00290, 0.00179, 0.00000)
var float PMDAY = CUM5.get(0)
vRem(float r) =>
    float rr = clamp(r, 0, 1380)
    int   b  = math.min(int(rr / 5), 275)
    float f  = (rr - 5 * b) / 5.0
    CUM5.get(b) + f * (CUM5.get(b + 1) - CUM5.get(b))
// CPI and NFP (08:30) and FOMC (14:00) days, 2025–27, with the release in minutes after 18:00
var array<int> EVD = array.from(20250110, 20250115, 20250129, 20250207, 20250212, 20250307, 20250312, 20250319, 20250404, 20250410, 20250502, 20250507, 20250513, 20250606, 20250611, 20250618, 20250703, 20250715, 20250730, 20250801, 20250812, 20250905, 20250911, 20250917, 20251024, 20251029, 20251120, 20251210, 20251216, 20251218, 20260109, 20260113, 20260128, 20260211, 20260213, 20260306, 20260311, 20260318, 20260403, 20260410, 20260429, 20260508, 20260512, 20260605, 20260610, 20260617, 20260702, 20260714, 20260729, 20260807, 20260812, 20260904, 20260911, 20260916, 20261002, 20261014, 20261028, 20261106, 20261110, 20261204, 20261209, 20261210, 20270108, 20270113, 20270127, 20270205, 20270211, 20270305, 20270310, 20270317, 20270402, 20270413, 20270428, 20270507, 20270512, 20270604, 20270609, 20270610, 20270702, 20270714, 20270728, 20270806, 20270811, 20270903, 20270914, 20270915, 20271008, 20271014, 20271027, 20271105, 20271110, 20271203, 20271208, 20271210)
var array<int> EVR = array.from(870, 870, 1200, 870, 870, 870, 870, 1200, 870, 870, 870, 1200, 870, 870, 870, 1200, 870, 870, 1200, 870, 870, 870, 870, 1200, 870, 1200, 870, 1200, 870, 870, 870, 870, 1200, 870, 870, 870, 870, 1200, 870, 870, 1200, 870, 870, 870, 870, 1200, 870, 870, 1200, 870, 870, 870, 870, 1200, 870, 870, 1200, 870, 870, 870, 1200, 870, 870, 870, 1200, 870, 870, 870, 870, 1200, 870, 870, 1200, 870, 870, 870, 1200, 870, 870, 870, 1200, 870, 870, 870, 870, 1200, 870, 870, 1200, 870, 870, 870, 1200, 870)
// day model: gradient-boosted trees (50 × depth 3, learning rate 0.2), trained on NQ + ES + RTY 1-minute 2018–24
dayTrees(float fLz, float fSd, float fR, float fRu, float fAge, float fPos, float fRef, float fOpn, float fTx, float fEv, float fDow) =>
    float s = -0.518844
    s += (fLz <= -0.70691 ? (fLz <= -1.86079 ? (fLz <= -2.60245 ? -0.26141 : -0.16733) : (fLz <= -1.31386 ? -0.07103 : 0.04773)) : (fLz <= 0.35175 ? (fLz <= -0.18112 ? 0.19080 : 0.31051) : (fLz <= 1.11168 ? 0.40243 : 0.51211)))
    s += (fLz <= -0.91678 ? (fLz <= -2.17474 ? (fLz <= -3.11070 ? -0.24969 : -0.17764) : (fLz <= -1.46461 ? -0.09231 : 0.00772)) : (fLz <= 0.14408 ? (fR <= 952.50000 ? 0.10241 : 0.20537) : (fR <= 982.50000 ? 0.22873 : 0.36495)))
    s += (fLz <= -0.80788 ? (fLz <= -1.78540 ? (fLz <= -2.81327 ? -0.21481 : -0.12423) : (fLz <= -1.22818 ? -0.03545 : 0.03150)) : (fLz <= 0.48948 ? (fLz <= -0.34398 ? 0.09343 : 0.18142) : (fLz <= 1.60904 ? 0.25666 : 0.32463)))
    s += (fLz <= -0.63291 ? (fLz <= -1.65990 ? (fLz <= -2.41815 ? -0.17723 : -0.08268) : (fRef <= -0.35815 ? -0.03035 : 0.03039)) : (fLz <= 0.79586 ? (fR <= 937.50000 ? 0.08107 : 0.16995) : (fLz <= 2.39292 ? 0.24666 : 0.29185)))
    s += (fLz <= -0.97132 ? (fLz <= -2.23569 ? (fLz <= -3.46378 ? -0.20403 : -0.12700) : (fLz <= -1.53837 ? -0.05604 : -0.00300)) : (fLz <= 0.00145 ? (fRef <= -0.93358 ? -0.03154 : 0.07370) : (fR <= 937.50000 ? 0.09675 : 0.22487)))
    s += (fLz <= -0.52199 ? (fLz <= -1.99822 ? (fLz <= -3.12289 ? -0.17735 : -0.09049) : (fR <= 907.50000 ? -0.02030 : 0.03825)) : (fLz <= 0.86159 ? (fRu <= 0.83550 ? 0.11892 : 0.03397) : (fLz <= 2.63350 ? 0.19823 : 0.25162)))
    s += (fLz <= -1.00263 ? (fLz <= -2.49651 ? (fLz <= -3.86188 ? -0.19025 : -0.11216) : (fRef <= -0.39762 ? -0.05646 : -0.01496)) : (fR <= 1042.50000 ? (fAge <= 623.50000 ? 0.01957 : 0.08777) : (fEv <= 599.50000 ? 0.16438 : -0.16955)))
    s += (fLz <= -0.44591 ? (fLz <= -1.56153 ? (fLz <= -2.85730 ? -0.13660 : -0.04838) : (fRef <= -0.46230 ? -0.02684 : 0.02224)) : (fLz <= 1.04101 ? (fRu <= 0.96418 ? 0.08474 : -0.01961) : (fRef <= -1.57508 ? 0.00375 : 0.20451)))
    s += (fLz <= -0.23315 ? (fLz <= -1.65560 ? (fLz <= -3.21015 ? -0.14045 : -0.04720) : (fDow <= 0.50000 ? 0.05354 : -0.00312)) : (fRef <= -1.75668 ? -0.23401 : (fLz <= 0.74971 ? 0.06547 : 0.18005)))
    s += (fLz <= -1.21539 ? (fLz <= -2.25079 ? (fLz <= -4.07608 ? -0.17091 : -0.06948) : (fEv <= 1035.00000 ? -0.01356 : -0.12047)) : (fR <= 952.50000 ? (fRef <= -1.77787 ? -0.25652 : 0.01306) : (fEv <= 599.50000 ? 0.10185 : -0.17004)))
    s += (fLz <= -0.25654 ? (fLz <= -2.10242 ? (fLz <= -3.61940 ? -0.14033 : -0.04923) : (fRef <= -1.32463 ? -0.11045 : 0.00040)) : (fLz <= 1.44107 ? (fRu <= 1.48122 ? 0.05686 : -0.15210) : (fLz <= 3.06789 ? 0.14808 : 0.21365)))
    s += (fLz <= 0.07258 ? (fLz <= -1.95233 ? (fEv <= 434.50000 ? -0.04373 : -0.09506) : (fRu <= 0.74028 ? 0.00878 : -0.04287)) : (fR <= 1027.50000 ? (fPos <= 0.19729 ? 0.05245 : -0.03439) : (fOpn <= 1.15757 ? 0.13736 : -0.13137)))
    s += (fLz <= -0.11903 ? (fR <= 787.50000 ? (fTx <= 1.50000 ? 0.01204 : -0.03840) : (fRu <= 0.52141 ? 0.03431 : -0.01494)) : (fEv <= 434.50000 ? (fR <= 772.50000 ? -0.01619 : 0.09608) : (fOpn <= -0.38460 ? -0.03959 : -0.20308)))
    s += (fR <= 1072.50000 ? (fAge <= 456.50000 ? (fRef <= -1.32463 ? -0.12604 : -0.02378) : (fPos <= 0.32221 ? 0.04302 : -0.01719)) : (fOpn <= 1.30809 ? (fEv <= 599.50000 ? 0.07245 : -0.14137) : (fTx <= 1143.50000 ? -0.23004 : -0.10140)))
    s += (fLz <= 0.71951 ? (fDow <= 0.50000 ? (fSd <= 0.00000 ? 0.06050 : -0.00474) : (fRef <= -0.20110 ? -0.03810 : 0.00073)) : (fLz <= 2.29058 ? (fRu <= 1.44763 ? 0.07710 : -0.19701) : (fRu <= 2.56779 ? 0.18398 : 0.01067)))
    s += (fLz <= -1.43004 ? (fLz <= -3.12317 ? (fLz <= -4.37078 ? -0.15313 : -0.07193) : (fRef <= 0.05671 ? -0.01701 : 0.01939)) : (fEv <= 434.50000 ? (fRef <= -0.39722 ? -0.00384 : 0.03765) : (fOpn <= 0.01290 ? -0.01847 : -0.16684)))
    s += (fLz <= 1.16039 ? (fRu <= 1.18063 ? (fLz <= -2.43175 ? -0.04506 : 0.00570) : (fPos <= 0.94174 ? -0.10203 : -0.04771)) : (fLz <= 3.06795 ? (fRu <= 1.51877 ? 0.10914 : -0.13092) : (fRef <= 1.17630 ? 0.19434 : 0.05837)))
    s += (fR <= 1222.50000 ? (fPos <= 0.32481 ? (fDow <= 0.50000 ? 0.05428 : 0.00331) : (fRu <= 1.37374 ? -0.01651 : -0.12508)) : (fOpn <= 1.37570 ? (fR <= 1312.50000 ? 0.04984 : 0.16481) : -0.13566))
    s += (fAge <= 83.50000 ? (fR <= 1312.50000 ? (fRu <= 1.13728 ? -0.03045 : -0.08508) : (fLz <= 0.01790 ? 0.10043 : 0.06977)) : (fTx <= 472.50000 ? (fTx <= 232.50000 ? 0.00878 : -0.05976) : (fEv <= 434.50000 ? 0.04439 : -0.08568)))
    s += (fR <= 727.50000 ? (fRef <= 0.06343 ? (fRu <= 0.41427 ? -0.01396 : -0.05232) : (fAge <= 656.50000 ? 0.01845 : 0.25559)) : (fEv <= 1035.00000 ? (fPos <= 0.54304 ? 0.03714 : -0.00229) : (fTx <= 38.50000 ? -0.26539 : -0.06446)))
    s += (fLz <= 1.15984 ? (fDow <= 0.50000 ? (fSd <= 0.00000 ? 0.04290 : -0.00520) : (fRef <= -0.28861 ? -0.02974 : 0.00041)) : (fRef <= -1.53145 ? -0.08649 : (fLz <= 1.97411 ? 0.05220 : 0.15867)))
    s += (fR <= 892.50000 ? (fTx <= 1.50000 ? (fRef <= 0.06140 ? 0.01412 : 0.11290) : (fRu <= 0.46369 ? -0.00859 : -0.03830)) : (fEv <= 599.50000 ? (fRu <= 0.54622 ? 0.04377 : 0.01062) : (fRef <= 0.00063 ? -0.13615 : -0.01616)))
    s += (fAge <= 253.50000 ? (fRu <= 1.48521 ? (fTx <= 476.50000 ? -0.02922 : 0.00614) : (fR <= 1267.50000 ? -0.13384 : -0.02044)) : (fPos <= 0.32221 ? (fTx <= 1.50000 ? 0.05983 : 0.01745) : (fRef <= 0.10250 ? -0.01493 : 0.05163)))
    s += (fAge <= 19.50000 ? (fR <= 1312.50000 ? (fLz <= -0.92932 ? -0.05002 : -0.09926) : (fRu <= 0.99368 ? 0.08953 : -0.01507)) : (fEv <= 1035.00000 ? (fRef <= -1.32463 ? -0.06841 : 0.00854) : (fTx <= 7.50000 ? -0.19976 : -0.02372)))
    s += (fOpn <= -0.36422 ? (fRef <= -1.63028 ? -0.09429 : (fRu <= 0.67365 ? 0.04964 : 0.04187)) : (fRef <= -0.85662 ? (fSd <= 0.00000 ? -0.00878 : -0.07665) : (fLz <= -3.04572 ? -0.04823 : 0.00489)))
    s += (fLz <= 1.77366 ? (fRu <= 0.79101 ? (fTx <= 646.50000 ? -0.00388 : 0.02625) : (fSd <= 0.00000 ? -0.06383 : -0.00218)) : (fRu <= 1.39785 ? (fRef <= -1.30220 ? 0.18595 : 0.15310) : (fLz <= 3.06293 ? -0.11068 : 0.12656)))
    s += (fDow <= 0.50000 ? (fSd <= 0.00000 ? (fRef <= -0.60992 ? 0.09362 : 0.01839) : (fRef <= 0.29939 ? -0.01301 : 0.08242)) : (fRef <= -0.29051 ? (fSd <= 0.00000 ? -0.00146 : -0.04746) : (fSd <= 0.00000 ? -0.01224 : 0.02066)))
    s += (fLz <= 0.81437 ? (fRu <= 0.79113 ? (fRef <= 0.10257 ? -0.00414 : 0.02283) : (fTx <= 473.00000 ? -0.08874 : -0.01594)) : (fRef <= -1.11969 ? (fAge <= 346.50000 ? -0.24248 : 0.02194) : (fRu <= 0.93241 ? 0.10652 : 0.05117)))
    s += (fEv <= 1035.00000 ? (fTx <= 1.50000 ? (fAge <= 342.50000 ? -0.00150 : 0.03716) : (fTx <= 472.50000 ? -0.01531 : 0.01235)) : (fDow <= 2.50000 ? (fTx <= 7.50000 ? -0.17970 : -0.04516) : 0.22179))
    s += (fAge <= 47.50000 ? (fR <= 1312.50000 ? (fLz <= 0.01313 ? -0.02805 : -0.11981) : (fRu <= 1.30516 ? 0.09752 : -0.03188)) : (fPos <= 0.13343 ? (fAge <= 342.50000 ? 0.00109 : 0.03939) : (fRef <= -1.76487 ? -0.12356 : 0.00203)))
    s += (fPos <= 0.80086 ? (fTx <= 472.50000 ? (fTx <= 253.50000 ? 0.00433 : -0.05475) : (fAge <= 829.50000 ? 0.01646 : 0.18276)) : (fR <= 1312.50000 ? (fLz <= -0.92714 ? -0.02575 : -0.05831) : (fRu <= 1.42332 ? 0.08923 : -0.06420)))
    s += (fLz <= -3.85259 ? (fLz <= -4.32294 ? (fRef <= 0.17476 ? -0.12994 : -0.05897) : (fRef <= -0.23307 ? -0.08806 : -0.03159)) : (fR <= 1237.50000 ? (fRu <= 0.48925 ? 0.00751 : -0.01210) : (fAge <= 10.50000 ? -0.02710 : 0.05819)))
    s += (fOpn <= -0.36422 ? (fRef <= -0.30561 ? (fRef <= -0.33533 ? 0.01343 : -0.24544) : (fRu <= 0.70070 ? 0.06750 : 0.05817)) : (fRu <= 1.80201 ? (fRef <= 0.10258 ? -0.00631 : 0.01325) : (fSd <= 0.00000 ? -0.04895 : -0.20942)))
    s += (fTx <= 1.50000 ? (fEv <= 1035.00000 ? (fAge <= 672.50000 ? 0.01111 : 0.05400) : (fRef <= -0.22236 ? 0.04312 : -0.21739)) : (fTx <= 97.50000 ? (fRef <= 0.05203 ? -0.03896 : 0.06103) : (fEv <= 434.50000 ? 0.00692 : -0.04028)))
    s += (fPos <= 0.43724 ? (fR <= 247.50000 ? (fSd <= 0.00000 ? 0.00076 : -0.03733) : (fTx <= 1.50000 ? 0.02766 : 0.00771)) : (fRu <= 0.46590 ? (fRef <= 0.29846 ? -0.00029 : 0.12401) : (fTx <= 483.50000 ? -0.04716 : -0.01054)))
    s += (fDow <= 0.50000 ? (fSd <= 0.00000 ? (fRef <= -0.60992 ? 0.08114 : 0.01487) : (fLz <= -0.41514 ? -0.01589 : 0.06218)) : (fRef <= -0.93328 ? (fRef <= -0.97894 ? -0.02130 : -0.11694) : (fRef <= -0.91592 ? 0.12605 : -0.00054)))
    s += (fLz <= 2.62469 ? (fRu <= 0.67130 ? (fLz <= 0.15173 ? 0.00106 : 0.06856) : (fSd <= 0.00000 ? -0.03639 : 0.00063)) : (fAge <= 87.50000 ? -0.03054 : (fPos <= 0.65798 ? 0.15977 : 0.04562)))
    s += (fRef <= -2.38041 ? -0.15863 : (fOpn <= -0.38065 ? (fRef <= -1.43579 ? 0.10887 : 0.02444) : (fRu <= 0.51949 ? 0.00309 : -0.01327)))
    s += (fR <= 1147.50000 ? (fRu <= 0.45229 ? (fRef <= 0.33268 ? 0.00088 : 0.15336) : (fDow <= 2.50000 ? -0.00453 : -0.02550)) : (fOpn <= 1.56187 ? (fRu <= 0.42362 ? 0.06762 : 0.02220) : -0.11143))
    s += (fLz <= -3.62096 ? (fLz <= -4.92124 ? (fOpn <= 0.04162 ? -0.04700 : -0.13887) : (fTx <= 120.50000 ? -0.08056 : -0.03494)) : (fEv <= 1035.00000 ? (fTx <= 474.50000 ? -0.00216 : 0.01251) : (fTx <= 7.50000 ? -0.15497 : -0.01024)))
    s += (fRef <= -0.85662 ? (fRef <= -0.86118 ? (fTx <= 42.50000 ? 0.01676 : -0.03499) : -0.22129) : (fRef <= -0.85306 ? 0.23376 : (fTx <= 97.50000 ? -0.00828 : 0.00585)))
    s += (fPos <= 0.90613 ? (fTx <= 646.50000 ? (fTx <= 232.50000 ? 0.00456 : -0.01709) : (fAge <= 708.50000 ? 0.01033 : 0.21026)) : (fR <= 1342.50000 ? (fRu <= 1.90955 ? -0.03939 : -0.08636) : 0.06470))
    s += (fRef <= -0.20373 ? (fSd <= 0.00000 ? (fAge <= 1370.50000 ? 0.00696 : -0.17694) : (fDow <= 2.50000 ? -0.00849 : -0.04883)) : (fRef <= -0.12044 ? (fRef <= -0.13314 ? 0.01383 : 0.12702) : (fSd <= 0.00000 ? -0.01344 : 0.01053)))
    s += (fRef <= -2.38671 ? -0.14902 : (fLz <= 1.65610 ? (fRu <= 0.67130 ? 0.00214 : -0.01210) : (fAge <= 235.50000 ? -0.00806 : 0.11381)))
    s += (fR <= 1297.50000 ? (fRu <= 0.44803 ? (fRef <= 0.30182 ? 0.00245 : 0.07964) : (fOpn <= -0.29263 ? 0.01097 : -0.01250)) : (fPos <= 0.98027 ? (fTx <= 1319.50000 ? 0.07546 : -0.05938) : 0.08613))
    s += (fLz <= -4.12460 ? (fTx <= 1149.00000 ? (fAge <= 1.50000 ? -0.13303 : -0.07438) : 0.04808) : (fRef <= -2.37405 ? -0.13976 : (fRef <= 0.18910 ? -0.00036 : 0.01340)))
    s += (fTx <= 97.50000 ? (fTx <= 77.50000 ? (fRef <= 0.06075 ? -0.00752 : 0.04939) : (fOpn <= -0.16626 ? -0.19516 : -0.04589)) : (fTx <= 229.50000 ? (fTx <= 216.50000 ? 0.01158 : 0.12443) : (fTx <= 319.50000 ? -0.05452 : 0.00352)))
    s += (fEv <= 1035.00000 ? (fTx <= 474.50000 ? (fTx <= 232.50000 ? 0.00300 : -0.03560) : (fTx <= 490.50000 ? 0.11257 : 0.00504)) : (fDow <= 2.50000 ? (fSd <= 0.00000 ? 0.00687 : -0.10121) : 0.17258))
    s += (fOpn <= 1.73839 ? (fTx <= 97.50000 ? (fTx <= 77.50000 ? -0.00178 : -0.06759) : (fTx <= 161.50000 ? 0.03007 : 0.00044)) : -0.12515)
    s += (fPos <= 0.42955 ? (fR <= 187.50000 ? (fLz <= -1.79859 ? -0.00895 : -0.02686) : (fTx <= 1.50000 ? 0.02030 : 0.00356)) : (fRu <= 0.45204 ? (fR <= 997.50000 ? -0.00102 : 0.04654) : (fRu <= 0.45629 ? -0.13158 : -0.00993)))
    1.0 / (1.0 + math.exp(-s))

// week model: Brownian, p = logistic(a + b·logit(2Φ(k·z) − 1)), z = distance / √(variance left in the week)
pWeek(float z) => lgs(0.514 + 1.017 * lgt(2.0 * nCdf(1.30 * z) - 1.0))

// ═══════════════════════════════════════════════════════════════ Data
[atrD, pdh, pdl] = request.security(syminfo.tickerid, "D", [ta.atr(14)[1], high[1], low[1]], lookahead = barmerge.lookahead_on)
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)
bool act   = timeframe.isintraday and timeframe.in_seconds() <= 3600
int  tfMin = int(timeframe.in_seconds() / 60)
int  relM  = ((hour(time, TZ) * 60 + minute(time, TZ)) - 1080 + 1440) % 1440
bool newD  = timeframe.change("D")
bool newW  = timeframe.change("W")
var float dO  = na
var float dH  = na
var float dL  = na
var int   dHr = na
var int   dLr = na
var int   dHt = na
var int   dLt = na
var float wH  = na
var float wL  = na
var int   wHt = na
var int   wLt = na
if newD or na(dH)
    dO  := open
    dH  := high
    dL  := low
    dHr := relM
    dLr := relM
    dHt := time
    dLt := time
else
    if high > dH
        dH  := high
        dHr := relM
        dHt := time
    if low < dL
        dL  := low
        dLr := relM
        dLt := time
if newW or na(wH)
    wH  := high
    wL  := low
    wHt := time
    wLt := time
else
    if high > wH
        wH  := high
        wHt := time
    if low < wL
        wL  := low
        wLt := time

// the trading day's date, weekday and the next release still ahead today
int  tdD  = time_tradingday
// time_tradingday is the trading day's date at 00:00 UTC (a Sunday-evening session belongs to Monday)
int  ymd  = year(tdD, "UTC") * 10000 + month(tdD, "UTC") * 100 + dayofmonth(tdD, "UTC")
int  dow0 = (dayofweek(tdD, "UTC") + 5) % 7
int  rNow = relM + tfMin
evAhead() =>
    float out = -1.0
    int   k   = EVD.binary_search_leftmost(ymd)
    while k < EVD.size() and k >= 0
        if EVD.get(k) != ymd
            break
        if EVR.get(k) > rNow - 1
            out := out < 0 ? EVR.get(k) : math.min(out, EVR.get(k))
        k += 1
    out

// ═══════════════════════════════════════════════════════════════ Odds
float pHD = na
float pLD = na
float pHW = na
float pLW = na
if act and atrD > 0 and not na(pdh) and rNow < 1380
    float v   = math.max(vRem(rNow), 1e-6)
    float rg  = dH - dL
    float ev  = evAhead()
    float zH  = (dH - close) / atrD / math.sqrt(v)
    float zL  = (close - dL) / atrD / math.sqrt(v)
    pHD := dayTrees(lgt(2.0 * nCdf(1.10 * zH) - 1.0), 1.0, rNow, rg / atrD, relM - dHr, rg > 0 ? (close - dL) / rg : 0.5, (dH - pdh) / atrD, (close - dO) / atrD, dHr, ev, dow0)
    pLD := dayTrees(lgt(2.0 * nCdf(1.10 * zL) - 1.0), -1.0, rNow, rg / atrD, relM - dLr, rg > 0 ? (dH - close) / rg : 0.5, (pdl - dL) / atrD, (dO - close) / atrD, dLr, ev, dow0)
    // week: the rest of today plus each full day left to Friday
    int   dLeft = math.max(4 - dow0, 0)
    float vw    = math.max(v + dLeft * PMDAY, 1e-6)
    pHW := pWeek((wH - close) / atrD / math.sqrt(vw))
    pLW := pWeek((close - wL) / atrD / math.sqrt(vw))

plot(pDay ? 100 * pHD : na, "Day high holds", color = cHi, linewidth = 2)
plot(pDay ? 100 * pLD : na, "Day low holds", color = cLo, linewidth = 2)
plot(pWk ? 100 * pHW : na, "Week high holds", color = color.new(cHi, 40), style = plot.style_circles, linewidth = 1)
plot(pWk ? 100 * pLW : na, "Week low holds", color = color.new(cLo, 40), style = plot.style_circles, linewidth = 1)
hline(50, "50%", color = color.new(cSub, 60), linestyle = hline.style_dotted)
hline(80, "80%", color = color.new(cSub, 80), linestyle = hline.style_dotted)

if alOn and act and barstate.isconfirmed
    if pHD >= alT / 100.0 and nz(pHD[1]) < alT / 100.0
        alert("Sakanade · " + syminfo.ticker + " · the day's high " + px(dH) + " now holds " + pc0(pHD) + " of the time to 16:59", alert.freq_once_per_bar_close)
    if pLD >= alT / 100.0 and nz(pLD[1]) < alT / 100.0
        alert("Sakanade · " + syminfo.ticker + " · the day's low " + px(dL) + " now holds " + pc0(pLD) + " of the time to 16:59", alert.freq_once_per_bar_close)

// ═══════════════════════════════════════════════════════════════ On price and the card (last bar)
var line  lHD = na
var line  lLD = na
var line  lHW = na
var line  lLW = na
var label bHD = na
var label bLD = na
var label bHW = na
var label bLW = na
var table TC = na
tipD = "Day: 18:00–17:00 ET. The chance the extreme is not exceeded before 16:59, from gradient-boosted trees on: a Brownian touch probability (distance in daily ATR(14) over the square root of the volatility still to come today, from the intraday profile), the time, the range used, where price sits in the range, the extreme against PDH / PDL, the move since 18:00, when the extreme was set, how long ago, a CPI / NFP / FOMC release still ahead and the weekday.\nScored on 2025 – Oct 2026 (fit 2018–24): predicted → actual 6→6, 15→15, 25→26, 35→36, 45→47, 55→57, 65→66, 75→78, 85→88, 96→98%. Brier 0.135 vs 0.239 flat."
tipW = "Week: Sunday 18:00 – Friday 17:00 ET. The chance the extreme is not exceeded before Friday 16:59, from the Brownian model alone: distance in daily ATR(14) over the square root of the volatility left in the week. Scored on 2025 – Oct 2026: 5→5, 15→12, 25→22, 35→33, 45→39, 55→48, 65→62, 75→74, 85→86, 97→97%; Brier 0.143 vs 0.248 flat. Gradient-boosted trees did not do better here, so they are not used."
cRow(int r, string k, string g, color gc, string v, string w, string tip) =>
    TC.cell(0, r, k, text_color = cSub, text_size = tSz, text_halign = text.align_left, bgcolor = cBody, text_font_family = font.family_monospace, tooltip = tip)
    TC.cell(1, r, g, text_color = gc, text_size = tSz, text_halign = text.align_left, bgcolor = cBody, text_font_family = font.family_monospace, tooltip = tip)
    TC.cell(2, r, v, text_color = cTxt, text_size = tSz, text_halign = text.align_left, bgcolor = cBody, text_font_family = font.family_monospace, tooltip = tip)
    TC.cell(3, r, w, text_color = cSub, text_size = tSz, text_halign = text.align_right, bgcolor = cBody, text_font_family = font.family_monospace, tooltip = tip)
setLv(line l, label b, int t0, float y, int xr, string tx, string tip, color c, bool hi) =>
    line.set_xy1(l, t0, y)
    line.set_xy2(l, xr, y)
    label.set_xy(b, xr, y)
    label.set_text(b, tx)
    label.set_tooltip(b, tip)
    label.set_textcolor(b, c)
    label.set_style(b, hi ? label.style_label_lower_left : label.style_label_upper_left)

if barstate.islast and act
    int xr = time + extN * timeframe.in_seconds() * 1000
    if na(lHD)
        lHD := line.new(na, na, na, na, xloc = xloc.bar_time, color = cHi, width = 1, force_overlay = true)
        lLD := line.new(na, na, na, na, xloc = xloc.bar_time, color = cLo, width = 1, force_overlay = true)
        lHW := line.new(na, na, na, na, xloc = xloc.bar_time, color = color.new(cHi, 30), style = line.style_dashed, width = 1, force_overlay = true)
        lLW := line.new(na, na, na, na, xloc = xloc.bar_time, color = color.new(cLo, 30), style = line.style_dashed, width = 1, force_overlay = true)
        bHD := label.new(na, na, "", xloc = xloc.bar_time, color = #00000000, size = tSz, force_overlay = true)
        bLD := label.new(na, na, "", xloc = xloc.bar_time, color = #00000000, size = tSz, force_overlay = true)
        bHW := label.new(na, na, "", xloc = xloc.bar_time, color = #00000000, size = tSz, force_overlay = true)
        bLW := label.new(na, na, "", xloc = xloc.bar_time, color = #00000000, size = tSz, force_overlay = true)
    if dayOn
        setLv(lHD, bHD, dHt, dH, xr, "Day high " + px(dH) + " · holds " + pc0(pHD), tipD, cHi, true)
        setLv(lLD, bLD, dLt, dL, xr, "Day low " + px(dL) + " · holds " + pc0(pLD), tipD, cLo, false)
    if wkOn
        bool sameH = dayOn and wH == dH
        bool sameL = dayOn and wL == dL
        setLv(lHW, bHW, wHt, wH, xr, (sameH ? "  = week high · holds " : "Week high " + px(wH) + " · holds ") + pc0(pHW), tipW, color.new(cHi, 20), not sameH)
        setLv(lLW, bLW, wLt, wL, xr, (sameL ? "  = week low · holds " : "Week low " + px(wL) + " · holds ") + pc0(pLW), tipW, color.new(cLo, 20), sameL)
    if showCrd
        bool mob = layI == "Mobile"
        if na(TC)
            TC := table.new(posOf(crdPos), 4, 12, border_width = 0, frame_width = 1, frame_color = cHdr, force_overlay = true)
        TC.clear(0, 0, 3, 11)
        TC.cell(0, 0, "SAKANADE", text_color = #ffffff, bgcolor = cHdr, text_size = tSz, text_halign = text.align_left, text_font_family = font.family_monospace)
        TC.cell(1, 0, mob ? "" : "IS IT IN?", text_color = #ffffff, bgcolor = cHdr, text_size = tSz, text_halign = text.align_left, text_font_family = font.family_monospace)
        TC.cell(2, 0, "holds", text_color = #ffffff, bgcolor = cHdr, text_size = tSz, text_halign = text.align_left, text_font_family = font.family_monospace)
        TC.cell(3, 0, hm(relM), text_color = #ffffff, bgcolor = cHdr, text_size = tSz, text_halign = text.align_right, text_font_family = font.family_monospace)
        cRow(1, "DAY HIGH", gauge(pHD, mob ? 6 : 10), cHi, pc0(pHD), px(dH) + " · " + hm(dHr), tipD)
        cRow(2, "DAY LOW", gauge(pLD, mob ? 6 : 10), cLo, pc0(pLD), px(dL) + " · " + hm(dLr), tipD)
        cRow(3, "WEEK HIGH", gauge(pHW, mob ? 6 : 10), cHi, pc0(pHW), px(wH), tipW)
        cRow(4, "WEEK LOW", gauge(pLW, mob ? 6 : 10), cLo, pc0(pLW), px(wL), tipW)
        if not mob
            float ev = evAhead()
            cRow(5, "release ahead", "", cSub, ev < 0 ? "none today" : hm(int(ev)), "", "A CPI / NFP (08:30) or FOMC (14:00) release still ahead today is one of the model's inputs.")
            cRow(6, "day H forms", "", cSub, "NY PM 35%", "AM 27 · Asia 17", "When the trading day's final high was made, NQ + ES + RTY 2018–26: Asia (18:00–00:00) 16.4%, London (00:00–06:00) 10.3%, 06:00–09:30 9.4%, NY AM (09:30–13:00) 27.1%, NY PM (13:00–17:00) 36.7% (2025–26: 17.1, 10.2, 12.1, 26.9, 33.6). The final low: Asia 22.5%, London 11.0%, 06:00–09:30 8.7%, NY AM 28.7%, NY PM 29.2%. Extremes pile up at the two ends of the day, as a random walk's do (the arcsine law).")
            cRow(7, "week H forms", "", cSub, "Fri 34%", "Mon 18", "The weekday of the week's high, 2018–24: Mon 18.3%, Tue 18.9, Wed 12.0, Thu 16.9, Fri 33.9 (2025–26: 20.9, 11.4, 18.6, 17.1, 31.9). The week's low: Mon 32.6%, Tue 16.1, Wed 10.9, Thu 16.5, Fri 23.9 (2025–26: 29.3, 16.3, 16.0, 8.7, 29.7). Monday and Friday hold the most, the ends of the window; no midweek day stands out the way the 'Tuesday low' teaching says.")
            cRow(8, "tested", "", cSub, "Brier 0.135", "flat 0.239", "Day model, 2025 – Oct 2026 out of sample: Brier 0.135, log-loss 0.420; the Brownian part alone 0.138 / 0.427; a flat rate 0.239 / 0.671. The trees' gain over the Brownian model: 0.007 log-loss (95% CI 0.003–0.011, day-clustered bootstrap), on NQ, ES and RTY each. The Brownian part carries 94% of the trees' splits; the time of day, the extreme against PDH / PDL, the range used, when the extreme was set and a release ahead carry the rest.")
