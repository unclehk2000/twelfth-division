//@version=6
// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © Unclehk2000
// Shinsō · draw on liquidity, with machine-learned odds. ICT's liquidity pools: the previous day's, week's and month's highs and
// lows (PDH / PDL, PWH / PWL, PMH / PML) and the Asia (20:00–00:00 ET) and London (02:00–05:00) ranges. Each live pool carries
// the chance it trades before 16:59 today, and the nearest buy-side and sell-side pools carry the odds of which trades first.
// Both come from gradient-boosted trees run inside Pine, trained on NQ + ES + RTY 1-minute 2018–24 and scored once on
// 2025 – Oct 2026. Pools (598,185 samples): Brier 0.088 against 0.167 for a flat rate and 0.090 for a Brownian distance-and-
// time model (log-loss gain 0.004, 95% CI 0.002–0.007). Race (66,417): Brier 0.166 against 0.168 for price's position between
// the two pools (gain 0.007, CI 0.002–0.011). The draw-on-liquidity readings (the other side already taken, pools stacked
// together, pools in the direction of the day's move) moved the odds by 1 point or less beyond distance and time.
// Concepts: liquidity pools, buy-side / sell-side liquidity, draw on liquidity and the killzone ranges are ICT's (Michael J.
// Huddleston). Not affiliated with or endorsed by ICT.
indicator("Shinsō · Draw on Liquidity Odds", "Shinsō", overlay = true, max_lines_count = 100, max_labels_count = 100, behind_chart = false)

TZ = "America/New_York"

// ═══════════════════════════════════════════════════════════════ Inputs
gV = "View"
themeI  = input.string("Auto", "Card theme", options = ["Auto", "Dark", "Light"], group = gV, display = display.none)
lblSzI  = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal"], group = gV, display = display.none)
showCrd = input.bool(true, "Card", group = gV, inline = "cd", display = display.none)
crdPos  = input.string("Top right", "", options = ["Top left", "Top center", "Top right", "Middle left", "Middle right", "Bottom left", "Bottom center", "Bottom right"], group = gV, inline = "cd", display = display.none)
layI    = input.string("Desktop", "Layout", options = ["Desktop", "Mobile"], group = gV, tooltip = "Desktop: every pool, the race and the tested rows. Mobile: the race and the two most likely pools.", display = display.none)

gP = "Pools"
onD = input.bool(true, "PDH / PDL", group = gP, inline = "p1", display = display.none)
onW = input.bool(true, "PWH / PWL", group = gP, inline = "p1", display = display.none)
onM = input.bool(true, "PMH / PML", group = gP, inline = "p1", display = display.none)
onA = input.bool(true, "Asia 20:00–00:00", group = gP, inline = "p2", display = display.none)
onL = input.bool(true, "London 02:00–05:00", group = gP, inline = "p2", tooltip = "The session ranges go live once the session ends (00:00 and 05:00 ET). All pools reset at 18:00.", display = display.none)
shTk = input.bool(true, "Keep taken pools (faded)", group = gP, display = display.none)
extN = input.int(12, "Extend right (bars)", minval = 0, maxval = 100, group = gP, display = display.none)
cBSL = input.color(#ef5350, "Buy-side", group = gP, inline = "c", display = display.none)
cSSL = input.color(#26a69a, "Sell-side", group = gP, inline = "c", display = display.none)

gA = "Alerts · create one with \"Any alert() function call\""
alT = input.bool(true, "Pool taken", group = gA, display = display.none)

// ═══════════════════════════════════════════════════════════════ Helpers
bgLum  = 0.299 * color.r(chart.bg_color) + 0.587 * color.g(chart.bg_color) + 0.114 * color.b(chart.bg_color)
isDark = themeI == "Dark" or (themeI == "Auto" and bgLum < 128)
cTxt   = isDark ? #d1d4dc : #131722
cBody  = isDark ? #161a23 : #f4f6f9
cSub   = isDark ? #8a93a6 : #5d6476
cHdr   = #ad1457
tSz = lblSzI == "Tiny" ? size.tiny : lblSzI == "Normal" ? size.normal : size.small
px(float v) => str.tostring(v, format.mintick)
pc0(float p) => na(p) ? "—" : str.tostring(math.round(100 * p)) + "%"
clamp(float v, float a, float b) => math.max(a, math.min(b, v))
gauge(float f, int n) =>
    int k = na(f) ? 0 : int(math.round(clamp(f, 0, 1) * n))
    str.repeat("█", k) + str.repeat("░", n - k)
posOf(string p) =>
    switch p
        "Top left"      => position.top_left
        "Top center"    => position.top_center
        "Top right"     => position.top_right
        "Middle left"   => position.middle_left
        "Middle right"  => position.middle_right
        "Bottom left"   => position.bottom_left
        "Bottom center" => position.bottom_center
        => position.bottom_right
nCdf(float x) =>
    float z = math.abs(x)
    float t = 1.0 / (1.0 + 0.2316419 * z)
    float p = 1.0 - 0.3989422804 * math.exp(-0.5 * z * z) * t * (0.319381530 + t * (-0.356563782 + t * (1.781477937 + t * (-1.821255978 + t * 1.330274429))))
    x >= 0 ? p : 1.0 - p
lgt(float p) =>
    float q = clamp(p, 0.000001, 0.999999)
    math.log(q / (1.0 - q))
hm(int r) =>
    int t = (r + 1080) % 1440
    str.tostring(int(t / 60), "00") + ":" + str.tostring(t % 60, "00")

// ═══════════════════════════════════════════════════════════════ Model constants
var array<float> CUM5 = array.from(1.12053, 1.10936, 1.10661, 1.10468, 1.10282, 1.10108, 1.09972, 1.09813, 1.09682, 1.09563, 1.09442, 1.09335, 1.09220, 1.09046, 1.08909, 1.08790, 1.08671, 1.08565, 1.08467, 1.08339, 1.08221, 1.08117, 1.07992, 1.07885, 1.07770, 1.07485, 1.07298, 1.07141, 1.06948, 1.06804, 1.06661, 1.06474, 1.06321, 1.06189, 1.06015, 1.05872, 1.05741, 1.05553, 1.05403, 1.05276, 1.05079, 1.04942, 1.04808, 1.04619, 1.04456, 1.04307, 1.04163, 1.04026, 1.03892, 1.03748, 1.03630, 1.03519, 1.03406, 1.03305, 1.03203, 1.03090, 1.02987, 1.02894, 1.02803, 1.02721, 1.02641, 1.02549, 1.02473, 1.02393, 1.02311, 1.02230, 1.02154, 1.02069, 1.02001, 1.01936, 1.01869, 1.01805, 1.01746, 1.01652, 1.01577, 1.01501, 1.01434, 1.01372, 1.01311, 1.01229, 1.01168, 1.01103, 1.01031, 1.00968, 1.00894, 1.00768, 1.00668, 1.00579, 1.00494, 1.00419, 1.00341, 1.00244, 1.00157, 1.00069, 0.99982, 0.99888, 0.99788, 0.99523, 0.99351, 0.99211, 0.99049, 0.98913, 0.98783, 0.98629, 0.98497, 0.98368, 0.98226, 0.98100, 0.97955, 0.97486, 0.97140, 0.96833, 0.96517, 0.96236, 0.95978, 0.95678, 0.95440, 0.95224, 0.94999, 0.94784, 0.94586, 0.94272, 0.94005, 0.93779, 0.93556, 0.93353, 0.93164, 0.92946, 0.92755, 0.92567, 0.92387, 0.92216, 0.92060, 0.91846, 0.91663, 0.91486, 0.91316, 0.91150, 0.90989, 0.90814, 0.90652, 0.90499, 0.90328, 0.90158, 0.89998, 0.89795, 0.89627, 0.89465, 0.89299, 0.89142, 0.88982, 0.88814, 0.88656, 0.88506, 0.88313, 0.88132, 0.87943, 0.87690, 0.87497, 0.87317, 0.87146, 0.86961, 0.86770, 0.86549, 0.86358, 0.86161, 0.85950, 0.85766, 0.85568, 0.85254, 0.85013, 0.84782, 0.84494, 0.84238, 0.83902, 0.81094, 0.80495, 0.80017, 0.79603, 0.79221, 0.78869, 0.78448, 0.78098, 0.77788, 0.77483, 0.77191, 0.76658, 0.73159, 0.70801, 0.68830, 0.66849, 0.65100, 0.63658, 0.61439, 0.59884, 0.58431, 0.57060, 0.55783, 0.54562, 0.53259, 0.52070, 0.50958, 0.49864, 0.48816, 0.47869, 0.46729, 0.45781, 0.44885, 0.44002, 0.43197, 0.42411, 0.41520, 0.40729, 0.39977, 0.39259, 0.38568, 0.37901, 0.37157, 0.36510, 0.35910, 0.35290, 0.34692, 0.34131, 0.33514, 0.32967, 0.32424, 0.31874, 0.31322, 0.30792, 0.30062, 0.29456, 0.28908, 0.28342, 0.27792, 0.27241, 0.26607, 0.26050, 0.25511, 0.24967, 0.24445, 0.23921, 0.22671, 0.21912, 0.21214, 0.20559, 0.19924, 0.19297, 0.18485, 0.17690, 0.16923, 0.16171, 0.15415, 0.14718, 0.13810, 0.13041, 0.12208, 0.11428, 0.10682, 0.09985, 0.09113, 0.08336, 0.07558, 0.06619, 0.05256, 0.03826, 0.02665, 0.02178, 0.01707, 0.01489, 0.01158, 0.01026, 0.00656, 0.00513, 0.00405, 0.00290, 0.00179, 0.00000)
vRem(float r) =>
    float rr = clamp(r, 0, 1380)
    int   b  = math.min(int(rr / 5), 275)
    float f  = (rr - 5 * b) / 5.0
    CUM5.get(b) + f * (CUM5.get(b + 1) - CUM5.get(b))
var array<int> EVD = array.from(20250110, 20250115, 20250129, 20250207, 20250212, 20250307, 20250312, 20250319, 20250404, 20250410, 20250502, 20250507, 20250513, 20250606, 20250611, 20250618, 20250703, 20250715, 20250730, 20250801, 20250812, 20250905, 20250911, 20250917, 20251024, 20251029, 20251120, 20251210, 20251216, 20251218, 20260109, 20260113, 20260128, 20260211, 20260213, 20260306, 20260311, 20260318, 20260403, 20260410, 20260429, 20260508, 20260512, 20260605, 20260610, 20260617, 20260702, 20260714, 20260729, 20260807, 20260812, 20260904, 20260911, 20260916, 20261002, 20261014, 20261028, 20261106, 20261110, 20261204, 20261209, 20261210, 20270108, 20270113, 20270127, 20270205, 20270211, 20270305, 20270310, 20270317, 20270402, 20270413, 20270428, 20270507, 20270512, 20270604, 20270609, 20270610, 20270702, 20270714, 20270728, 20270806, 20270811, 20270903, 20270914, 20270915, 20271008, 20271014, 20271027, 20271105, 20271110, 20271203, 20271208, 20271210)
var array<int> EVR = array.from(870, 870, 1200, 870, 870, 870, 870, 1200, 870, 870, 870, 1200, 870, 870, 870, 1200, 870, 870, 1200, 870, 870, 870, 870, 1200, 870, 1200, 870, 1200, 870, 870, 870, 870, 1200, 870, 870, 870, 870, 1200, 870, 870, 1200, 870, 870, 870, 870, 1200, 870, 870, 1200, 870, 870, 870, 870, 1200, 870, 870, 1200, 870, 870, 870, 1200, 870, 870, 870, 1200, 870, 870, 870, 870, 1200, 870, 870, 1200, 870, 870, 870, 1200, 870, 870, 870, 1200, 870, 870, 870, 870, 1200, 870, 870, 1200, 870, 870, 870, 1200, 870)
// pool model: 50 gradient-boosted trees, depth 3, trained on NQ + ES + RTY 1-minute 2018–24 (2.3 million samples)
poolTrees(float fLz, float fTyp, float fSd, float fR, float fNb, float fCf, float fOpp, float fSame, float fTow, float fEv, float fDow) =>
    float s = -1.294024
    s += (fLz <= 0.53392 ? (fLz <= -0.40624 ? (fLz <= -1.43501 ? -0.24681 : -0.15816) : (fLz <= 0.05222 ? -0.03207 : 0.08967)) : (fLz <= 1.47603 ? (fLz <= 0.99897 ? 0.24665 : 0.41646) : (fLz <= 2.16584 ? 0.58729 : 0.77143)))
    s += (fLz <= 0.43674 ? (fLz <= -0.63375 ? (fLz <= -1.99109 ? -0.23823 : -0.16968) : (fLz <= -0.07328 ? -0.05761 : 0.04545)) : (fLz <= 1.55214 ? (fLz <= 0.91525 ? 0.15696 : 0.26409) : (fLz <= 2.44964 ? 0.35944 : 0.44679)))
    s += (fLz <= 0.50960 ? (fLz <= -0.52175 ? (fLz <= -1.76978 ? -0.22672 : -0.14212) : (fLz <= -0.02518 ? -0.03907 : 0.04508)) : (fLz <= 1.73456 ? (fLz <= 1.20878 ? 0.13665 : 0.21408) : (fLz <= 2.67470 ? 0.27978 : 0.34104)))
    s += (fLz <= 0.68421 ? (fLz <= -0.75498 ? (fLz <= -2.50642 ? -0.22310 : -0.15554) : (fLz <= 0.15990 ? -0.02910 : 0.05115)) : (fLz <= 1.84245 ? (fEv <= 0.50000 ? 0.13375 : 0.22695) : (fLz <= 2.88787 ? 0.22950 : 0.29237)))
    s += (fLz <= 0.37544 ? (fLz <= -0.84491 ? (fLz <= -2.19003 ? -0.21566 : -0.14031) : (fEv <= 0.50000 ? -0.02706 : 0.08996)) : (fLz <= 1.28291 ? (fEv <= 0.50000 ? 0.06552 : 0.16348) : (fLz <= 1.96346 ? 0.14194 : 0.20855)))
    s += (fLz <= 0.81173 ? (fLz <= -0.30934 ? (fLz <= -1.10421 ? -0.19500 : -0.06596) : (fR <= 1027.50000 ? 0.03206 : -0.05725)) : (fLz <= 1.77864 ? (fDow <= 0.50000 ? 0.06467 : 0.10498) : (fLz <= 2.69560 ? 0.14801 : 0.21515)))
    s += (fLz <= 0.74104 ? (fLz <= -0.40097 ? (fLz <= -2.10781 ? -0.20446 : -0.08719) : (fDow <= 1.50000 ? -0.02264 : 0.03806)) : (fLz <= 1.29419 ? (fEv <= 0.50000 ? 0.05136 : 0.11777) : (fLz <= 2.01445 ? 0.09930 : 0.15533)))
    s += (fLz <= 0.23557 ? (fLz <= -1.07961 ? (fLz <= -2.96047 ? -0.20650 : -0.12842) : (fEv <= 0.50000 ? -0.03056 : 0.07475)) : (fLz <= 1.28110 ? (fEv <= 0.50000 ? 0.02977 : 0.09571) : (fLz <= 2.44001 ? 0.08144 : 0.15909)))
    s += (fLz <= 0.15523 ? (fLz <= -0.92259 ? (fEv <= 0.50000 ? -0.17101 : -0.09240) : (fDow <= 1.50000 ? -0.05172 : 0.00771)) : (fLz <= 1.11589 ? (fEv <= 0.50000 ? 0.02046 : 0.07562) : (fLz <= 3.08430 ? 0.07131 : 0.17987)))
    s += (fLz <= 0.04283 ? (fLz <= -1.77453 ? (fLz <= -3.53151 ? -0.20408 : -0.14041) : (fEv <= 0.50000 ? -0.03869 : 0.05718)) : (fLz <= 1.97675 ? (fDow <= 0.50000 ? -0.00071 : 0.03562) : (fEv <= 0.50000 ? 0.09324 : 0.14735)))
    s += (fLz <= 0.83823 ? (fLz <= -0.38966 ? (fLz <= -2.10989 ? -0.18934 : -0.04478) : (fR <= 952.50000 ? 0.01554 : -0.03651)) : (fLz <= 2.71082 ? (fTow <= 0.45235 ? 0.03971 : 0.11190) : (fLz <= 3.64662 ? 0.11527 : 0.18775)))
    s += (fLz <= 0.84012 ? (fLz <= -0.62135 ? (fTyp <= 0.50000 ? -0.04265 : -0.14045) : (fTyp <= 2.50000 ? -0.00546 : 0.04252)) : (fLz <= 1.66398 ? (fTow <= -0.07847 ? 0.03795 : 0.01249) : (fEv <= 0.50000 ? 0.05619 : 0.10619)))
    s += (fLz <= 0.84557 ? (fLz <= -1.34016 ? (fLz <= -3.29037 ? -0.19682 : -0.07687) : (fDow <= 1.50000 ? -0.02232 : 0.01613)) : (fLz <= 2.25226 ? (fEv <= 0.50000 ? 0.01836 : 0.05503) : (fLz <= 3.46783 ? 0.07137 : 0.15833)))
    s += (fLz <= 0.83731 ? (fEv <= 0.50000 ? (fTyp <= 2.50000 ? -0.04709 : 0.01574) : (fR <= 1072.50000 ? 0.02101 : 0.39804)) : (fLz <= 2.96923 ? (fTow <= 0.35719 ? 0.02058 : 0.06853) : (fLz <= 3.76100 ? 0.09670 : 0.16772)))
    s += (fLz <= -0.18649 ? (fLz <= -2.55563 ? (fLz <= -4.75417 ? -0.19914 : -0.14447) : (fSd <= 0.00000 ? 0.01918 : -0.05738)) : (fR <= 952.50000 ? (fTyp <= 2.50000 ? 0.01199 : 0.04189) : (fTow <= 0.79434 ? -0.02299 : 0.07395)))
    s += (fLz <= -0.09410 ? (fLz <= -1.74531 ? (fEv <= 0.50000 ? -0.16227 : -0.04690) : (fSd <= 0.00000 ? 0.02029 : -0.03261)) : (fR <= 1027.50000 ? (fTow <= 0.35781 ? 0.01464 : 0.07868) : (fDow <= 0.50000 ? -0.08343 : -0.01337)))
    s += (fLz <= 1.41793 ? (fTyp <= 2.50000 ? (fEv <= 0.50000 ? -0.02705 : 0.02216) : (fR <= 967.50000 ? 0.03912 : -0.02983)) : (fEv <= 0.50000 ? (fLz <= 3.10516 ? 0.01401 : 0.09727) : (fDow <= 2.50000 ? 0.10337 : 0.02736)))
    s += (fLz <= -1.33982 ? (fTyp <= 0.50000 ? (fR <= 742.50000 ? 0.11167 : -0.07752) : (fEv <= 0.50000 ? -0.15115 : -0.04588)) : (fR <= 787.50000 ? (fTow <= -0.55522 ? 0.13647 : 0.01254) : (fEv <= 0.50000 ? -0.01210 : 0.06125)))
    s += (fLz <= -0.19655 ? (fEv <= 0.50000 ? (fSd <= 0.00000 ? -0.03083 : -0.08205) : (fLz <= -3.35858 ? -0.15814 : 0.06410)) : (fTow <= 0.35170 ? (fDow <= 0.50000 ? -0.01036 : 0.01170) : (fR <= 532.50000 ? 0.13199 : 0.03953)))
    s += (fLz <= 1.97851 ? (fLz <= -3.02628 ? (fNb <= 0.50000 ? -0.13330 : -0.18733) : (fDow <= 0.50000 ? -0.01711 : 0.00643)) : (fLz <= 3.64706 ? (fTow <= 0.26349 ? 0.03102 : -0.00903) : (fTow <= 0.08899 ? 0.11892 : 0.17981)))
    s += (fLz <= -1.10418 ? (fLz <= -3.45490 ? (fLz <= -5.77669 ? -0.19621 : -0.15138) : (fSd <= 0.00000 ? 0.02970 : -0.07401)) : (fTow <= 0.88163 ? (fR <= 1057.50000 ? 0.00851 : -0.03701) : 0.15859))
    s += (fLz <= -1.09996 ? (fLz <= -2.47748 ? (fEv <= 0.50000 ? -0.16768 : -0.03669) : (fTow <= -0.55747 ? 0.15270 : -0.01954)) : (fTow <= 0.36905 ? (fDow <= 2.50000 ? -0.00089 : 0.01509) : (fR <= 412.50000 ? 0.16554 : 0.03603)))
    s += (fLz <= 2.26212 ? (fOpp <= 0.50000 ? (fSd <= 0.00000 ? 0.03264 : -0.01050) : (fDow <= 0.50000 ? -0.03057 : -0.00599)) : (fTow <= 0.26487 ? (fSd <= 0.00000 ? 0.02192 : 0.05302) : (fDow <= 0.50000 ? -0.09348 : 0.03398)))
    s += (fTyp <= 2.50000 ? (fEv <= 0.50000 ? (fSd <= 0.00000 ? 0.00232 : -0.02155) : (fTow <= -0.03715 ? -0.01534 : 0.04596)) : (fCf <= 0.50000 ? (fSd <= 0.00000 ? 0.00573 : 0.05157) : (fDow <= 0.50000 ? -0.04859 : 0.00062)))
    s += (fLz <= 1.90994 ? (fR <= 1042.50000 ? (fTow <= -0.15434 ? 0.01389 : -0.00569) : (fEv <= 0.50000 ? -0.05751 : 0.23791)) : (fEv <= 0.50000 ? (fLz <= 2.75732 ? 0.00534 : 0.04744) : (fDow <= 2.50000 ? 0.08900 : 0.01420)))
    s += (fLz <= -1.87137 ? (fEv <= 0.50000 ? (fCf <= 0.50000 ? -0.14420 : -0.03882) : (fLz <= -3.28782 ? -0.15062 : 0.18221)) : (fTow <= -1.01430 ? 0.30784 : (fTow <= 0.49897 ? 0.00275 : 0.05496)))
    s += (fR <= 517.50000 ? (fTow <= -0.24789 ? (fSame <= 0.50000 ? 0.03659 : 0.13413) : (fLz <= 1.58290 ? -0.00202 : 0.02045)) : (fLz <= 2.67875 ? (fOpp <= 0.50000 ? -0.02395 : -0.00591) : (fSd <= 0.00000 ? 0.00452 : 0.07656)))
    s += (fOpp <= 1.50000 ? (fTow <= -0.54366 ? 0.27225 : (fSd <= 0.00000 ? 0.02106 : -0.00755)) : (fSd <= 0.00000 ? (fLz <= 0.16574 ? -0.01009 : -0.02857) : (fTyp <= 2.50000 ? -0.01694 : 0.03454)))
    s += (fLz <= -1.39218 ? (fDow <= 3.50000 ? (fEv <= 0.50000 ? -0.07125 : 0.09645) : (fEv <= 0.50000 ? -0.11965 : -0.16681)) : (fTow <= 0.87497 ? (fTow <= -0.90499 ? 0.14976 : 0.00305) : 0.10917))
    s += (fLz <= 2.53548 ? (fOpp <= 0.50000 ? (fTow <= -0.12406 ? 0.04903 : 0.00131) : (fDow <= 0.50000 ? -0.02019 : -0.00167)) : (fTow <= 0.03769 ? (fR <= 367.50000 ? -0.03854 : 0.02984) : (fTyp <= 0.50000 ? 0.08410 : 0.03295)))
    s += (fNb <= 0.50000 ? (fSame <= 0.50000 ? (fSd <= 0.00000 ? -0.03128 : 0.03638) : (fR <= 412.50000 ? 0.03397 : 0.00404)) : (fTyp <= 0.50000 ? (fOpp <= 1.50000 ? 0.01808 : -0.01000) : (fLz <= -0.06522 ? -0.02893 : -0.01280)))
