//@version=6
// Benihime · RTH gaps mapped like NWOGs. RTH gap = the prior RTH close (the 16:14 bar's close, 16:15 ET) to the 09:30 ET
// open: the overnight move between two regular sessions. Every gap runs right in price. The last 5 sessions' gaps form
// the staircase: octants plus ±1 / ±2 SD (gap-size multiples above the top and below the bottom). Older gaps show
// quarters until N sessions old, then edges and CE. The card tracks the average RTH gap and today's gap against it,
// with odds from NQ + ES + RTY 1-minute 2018–26 (6,169 gaps). Live fill and CE odds follow the gap's size, the time,
// how far price is from the fill now, how far it has come back so far, and where the open sat in the overnight range.
// A tally-style card (Desktop / Mobile) with a fill bar, and alerts. Release days (CPI, NFP, PPI, GDP, PCE, retail
// sales, your own dates) switch the day's regime. Works on ETH and RTH charts. Use a back-adjusted (B-ADJ) continuous
// chart so roll days do not show as gaps.
indicator("Benihime — RTH Gaps", "Benihime", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 50)

TZ = "America/New_York"

// ═══════════════════════════════════════════════════════════════ Inputs
gV = "View"
themeI  = input.string("Auto", "Card theme", options = ["Auto", "Dark", "Light"], group = gV, tooltip = "The card. Auto follows the chart background. Its text always follows this theme, so it stays readable whatever chart text colour you pick.", display = display.none)
lblSzI  = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal"], group = gV, display = display.none)
txtColI = input.color(#000001, "Chart text colour", group = gV, tooltip = "The labels on the chart. Left at the default it follows the chart background; pick any colour to override. The card keeps its own text colour.", display = display.none)
lblMode = input.string("Last 5", "Gap labels", options = ["Last 5", "All", "Off"], group = gV, tooltip = "One label per gap at its CE on the right: date, release tag, and CE / filled. Labels at nearly the same price share one. Hover a label for the gap's numbers.", display = display.none)
dateFmt = input.string("MM/dd", "Label date format", group = gV, display = display.none)
showCard = input.bool(true, "Card", group = gV, inline = "cd", display = display.none)
cardPos  = input.string("Top right", "", options = ["Top left", "Top center", "Top right", "Middle left", "Middle right", "Bottom left", "Bottom center", "Bottom right"], group = gV, inline = "cd", display = display.none)
layI     = input.string("Desktop", "Layout", options = ["Desktop", "Mobile"], group = gV, tooltip = "Desktop: every row. Mobile: one narrow card for a phone screen: the gap, the fill bar, the CE and ±1 SD (outside RTH: the close, if it opened now, and the next session). Every row keeps its full explanation in the tooltip. For a phone, use a separate chart layout set to Mobile, since layouts sync across devices.", display = display.none)
barCI    = input.string("Gap direction", "Fill bar", options = ["Gap direction", "Progress"], group = gV, inline = "fb", tooltip = "The FILL bar fills as price trades back from the open toward the prior close; the mark in the middle is the CE.\nGap direction: the first colour for a gap up, the second for a gap down.\nProgress: the second colour until the gap fills, then the first.", display = display.none)
colBU    = input.color(#26a69a, "", group = gV, inline = "fb", display = display.none)
colBD    = input.color(#ef5350, "", group = gV, inline = "fb", display = display.none)

gG = "RTH gaps · 16:14 close → 09:30 open (ET)"
keepN  = input.int(20, "Keep last (sessions)", minval = 5, maxval = 60, group = gG, tooltip = "How many RTH gaps stay on the chart, newest first. They all run right in price.\n\nThe gaps are read from 15-minute bars of this chart's symbol. On a 1-minute ETH chart only the days the chart has loaded can show: scroll left to load more, or use an RTH chart or a 3 / 5 / 15-minute chart for 20+ sessions. The card says how many are loaded.", display = display.none)
quadN  = input.int(10, "Quarters until (sessions old)", minval = 5, maxval = 60, group = gG, tooltip = "Gaps older than the staircase (last 5) show their quarters (25%, CE, 75%) until they are this many sessions old; older gaps show their edges and CE only.\n\nNQ + ES + RTY 2018–26: a gap still unfilled after 5 sessions filled within the next 15 sessions 49% of the time; one whose CE was untouched after 5 sessions reached it 52% of the time.", display = display.none)
avgNI  = input.int(20, "Average over (sessions)", minval = 5, maxval = 100, group = gG, tooltip = "The card's average RTH gap: the mean |gap| of this many sessions before today. Every day counts, Mondays included. The size tag and the odds always use the 20-session average they were measured with.", display = display.none)
colN   = input.color(#26a69a, "Normal day", group = gG, display = display.none)
shadeI = input.string("Staircase", "Shade", options = ["Staircase", "All", "Off"], group = gG, display = display.none)
extN   = input.int(10, "Run past the last bar (bars)", minval = 0, maxval = 200, group = gG, display = display.none)
minTk  = input.int(1, "Skip gaps smaller than (ticks)", minval = 0, group = gG, display = display.none)

gS = "Staircase · last 5 sessions"
octI  = input.bool(true, "Octants", group = gS, tooltip = "Each of the last 5 gaps split into eighths. The CE (50%) is dashed, the quarters dotted, the eighths faint.", display = display.none)
sd1I  = input.bool(true, "±1 SD", inline = "sd", group = gS, display = display.none)
sd2I  = input.bool(true, "±2 SD", inline = "sd", group = gS, tooltip = "k SD = k gap sizes above the gap's top (+) and below its bottom (−), for each of the last 5 gaps (and release days, see below). The ±2 SD lines carry the gap's weekday.\n\nNQ + ES + RTY 2018–26, while a gap is one of the last 5 (to the 5th next open): beyond the open (gap direction) +1 SD 84%, +2 SD 71%; beyond the prior close −1 SD 71%, −2 SD 60%. Small gaps reach theirs far more often (the card shows today's size).", display = display.none)
sdW   = input.int(1, "SD lines: width", options = [1, 2, 3], inline = "sdw", group = gS, display = display.none)
sdSt  = input.string("Dashed", "±1 SD", options = ["Solid", "Dashed", "Dotted"], inline = "sdw", group = gS, tooltip = "±2 SD lines are always solid; pick the ±1 SD style here.", display = display.none)
colSD = input.color(#787b86, "SD colour", inline = "sdc", group = gS, display = display.none)
sdTie = input.bool(true, "In the gap's colour", inline = "sdc", group = gS, display = display.none)
sdDay = input.bool(true, "Weekday on the ±2 SD", group = gS, tooltip = "At the right end of each gap's +2 SD and −2 SD lines (±1 SD when ±2 is off): the gap's weekday, e.g. Tue +2 SD, with the release tag on release days. Labels close in price share one.", display = display.none)
sdRel = input.bool(true, "Release days keep their SD staircase", group = gS, tooltip = "Gaps from CPI, NFP, PPI, GDP, PCE, retail sales or your dates keep their ±1 / ±2 SD lines and weekday labels for as long as they stay on the chart, not only while they are one of the last 5. Their labels then add the date.", display = display.none)

gR = "Release regime · 08:30 ET releases before the open"
useCPI = input.bool(true, "CPI", inline = "r1", group = gR, display = display.none)
useNFP = input.bool(true, "NFP", inline = "r1", group = gR, display = display.none)
colX   = input.color(#ff9800, "", inline = "r1", group = gR, tooltip = "Major releases. NQ + ES + RTY 2018–26: CPI and NFP gaps run 1.4–1.5× the size of normal-day gaps (p < 0.001, both periods and every symbol); 35–40% are over 1.5× the 20-session average, against 21% on normal days. For their size they behave like any other gap (fill, CE and SD odds did not differ), so the card's odds come from the size tables.", display = display.none)
usePPI = input.bool(true, "PPI", inline = "r2", group = gR, display = display.none)
useGDP = input.bool(true, "GDP", inline = "r2", group = gR, display = display.none)
usePCE = input.bool(true, "PCE", inline = "r2", group = gR, display = display.none)
useRS  = input.bool(true, "Retail sales", inline = "r2", group = gR, display = display.none)
colY   = input.color(#7e57c2, "", inline = "r2", group = gR, tooltip = "Other 08:30 releases: PPI (BLS), GDP and PCE / personal income and outlays (BEA), retail sales (Census). NQ + ES + RTY 2018–26: their 08:30–08:34 range runs 1.8–3.6× a normal day's (every period and symbol), so they move price at the release; their RTH gaps were not reliably bigger (PPI 1.14×, GDP 1.20×, retail 1.18×, PCE 1.00×; none steady across both periods).", display = display.none)
ownTx  = input.string("", "Your dates", group = gR, tooltip = "Extra release days, e.g. ISM-free 08:30 data or one-off events: 2026-10-16, 2026-11-13 (commas; 20261016 works too). Tagged NEWS in the other-release colour.", display = display.none)

gA = "Alerts · create one with \"Any alert() function call\""
alNew = input.bool(true, "New gap at 09:30", group = gA, tooltip = "Each fires once, on the bar it happens, with the numbers in the message: the gap's size against the average and its fill odds; the CE; the fill and the odds of −1 SD after it; ±1 SD.", display = display.none)
alCE  = input.bool(true, "CE reached", group = gA, display = display.none)
alFL  = input.bool(true, "Filled", group = gA, display = display.none)
alSD  = input.bool(false, "±1 SD reached", group = gA, display = display.none)

